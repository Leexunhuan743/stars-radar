# Local build configuration. Copy to .env and replace placeholders.
# pnpm dev:stars loads .env. CI uses exported environment variables instead.
# Python clients read shell environment variables, not this file.
# Worker development uses .dev.vars.example; deployed Workers use Wrangler secrets.

# Personal GitHub token for public stars, GraphQL Lists and live GitHub searches.
# A classic token with public_repo and read:user supports the documented workflow.
# Actions uses secret GH_TOKEN and maps it to GITHUB_TOKEN during the build.
GITHUB_TOKEN=replace_with_your_github_token

# Required when building new/changed vectors; deployed query embeddings use the same model.
SILICONFLOW_KEY=replace_with_your_siliconflow_key
# Optional endpoint override; must serve BAAI/bge-m3 in the same vector space.
SILICONFLOW_URL=https://api.siliconflow.cn/v1/embeddings
# Optional hard cap for metadata + README vector records. Metadata vectors always win when the corpus exceeds the cap.
VECTOR_CORPUS_MAX_RECORDS=10000

# Private read service key. Required by Worker and Python clients, not by offline builds.
MCP_API_KEY=replace_with_a_random_read_key
# Required write key. Read and write credentials must be different.
MCP_WRITE_API_KEY=replace_with_a_different_random_write_key
# MCP exposure profile: research (default/read-only) or all (explicitly expose write tools too).
MCP_TOOLSET=research

# Cloudflare account and bucket. R2_BUCKET must match wrangler.jsonc.
# CI S3 publishing requires these plus R2_ACCESS_KEY_ID/R2_SECRET_ACCESS_KEY.
R2_ACCOUNT_ID=replace_with_your_cloudflare_account_id
R2_BUCKET=your-radar-bucket
R2_ACCESS_KEY_ID=replace_with_your_r2_s3_access_key_id
R2_SECRET_ACCESS_KEY=replace_with_your_r2_s3_secret_access_key

# Optional for CI Worker deployment; required for local harvest journal appends
# and R2 REST vector restoration together with R2_ACCOUNT_ID and R2_BUCKET.
# Grant permissions for the intended Worker/bucket operations on your account.
CLOUDFLARE_API_TOKEN=replace_with_your_cloudflare_api_token

# Required by Python REST clients. Use YOUR deployed URL, without /mcp.
# --help and local --harvest do not contact the Worker.
WORKER_URL=https://stars.example.com

# Web search providers. Tried in this order, each falling back on failure.
# Brave and Tavily require a key. Exa works without one through its rate-limited keyless MCP tier,
# so search_web_tech stays available when no key is configured at all.
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
# Optional. With a key Exa uses its REST API; without one it degrades to the keyless MCP tier,
# which is rate limited and cannot scope a domain or a date window.
EXA_API_KEY=
# Optional Tavily-compatible proxy. It authenticates with a Bearer header and wraps its payload
# in a { code, message, data } envelope, and it reports exhausted credit as HTTP 200 with a
# non-zero code, which is treated as a provider failure. Override the endpoint for other hosts.
TAVILY_PROXY_KEY=
# TAVILY_PROXY_URL=https://tavily.sharyuke.com/api/proxy/search

# Build-time concurrency. Both are optional and default to the values below.
# VECTOR_EMBED_CONCURRENCY bounds how many embedding batches are in flight at once. Each batch
# carries 16 records; the provider is rate-limited per key, so raise this only if you know your
# quota absorbs it. Lower it when a large corpus starts returning 429s.
# VECTOR_EMBED_CONCURRENCY=6
# README_VERIFY_CONCURRENCY bounds how many README blobs are fetched and re-hashed while a
# generation is validated. 1k+ blobs at the default is roughly 18 waves instead of 71.
# README_VERIFY_CONCURRENCY=64
# Set by the data workflow only: the corpus restore writes a receipt of the blobs whose digests it
# observed on disk, and validation skips refetching exactly those. Unset means "verify everything",
# which is correct but slower; it is not meant to be set by hand.
# README_VERIFY_RECEIPT_FILE=

# Optional local proxy. Set to your own proxy endpoint when needed.
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
