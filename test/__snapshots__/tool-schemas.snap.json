{
  "search_github_stars": {
    "name": "search_github_stars",
    "readOnly": true,
    "schema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "maxLength": 512
        },
        "explain": {
          "default": false,
          "type": "boolean"
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "source": {
          "type": "string",
          "enum": [
            "starred",
            "curated",
            "archive",
            "community",
            "ranking",
            "trending",
            "top_starred",
            "hellogithub",
            "breakout",
            "skill",
            "skill_repo"
          ]
        },
        "scope": {
          "default": "all",
          "type": "string",
          "enum": [
            "all",
            "starred",
            "rankings"
          ]
        },
        "limit": {
          "default": 5,
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "min_score": {
          "default": 0.25,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "query",
        "explain",
        "scope",
        "limit",
        "min_score"
      ],
      "additionalProperties": false
    }
  },
  "get_repo_readme": {
