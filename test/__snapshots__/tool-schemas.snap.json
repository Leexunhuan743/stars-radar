          "maxLength": 64
        },
        "limit": {
          "default": 10,
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        }
      },
      "required": [
        "query",
        "min_stars",
        "sort",
        "order",
        "limit"
      ],
      "additionalProperties": false
    }
