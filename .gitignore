# End of https://www.toptal.com/developers/gitignore/api/node

.env
.dev.vars
.wrangler
# Generated star data (regenerated by CI; uploaded directly to R2)
stars/
embeddings.bin

# The data plane. Every file below is a runtime document whose authority is R2: the scheduled
# build downloads it, updates it, and uploads it back, and the Worker reads it from the bucket.
# While any of them was committed, the checkout was the build's input, which is how a stale copy
# could overwrite what the Worker had just published. Nothing here is a source file — a fresh
# clone bootstraps from the user's own GitHub account.
catalog.json
rankings/rankings.json
asset-state.json
embeddings-index.json
embeddings-fingerprints.json
embeddings-manifest.json
AWESOME_STARS.md
stars.opml

# Local-only artifacts derived from the above. asset-index.json is the runtime index the Worker
# reads, so it is uploaded to R2 and never committed; asset-meta.json is a count summary nothing
# reads.
asset-index.json
asset-meta.json
previous-asset-index.json
previous-readmes.json
.data-compaction-plan.json
.readme-sync-status.json
active-generation.json
.generation-stage/
.readme-content-stage/
generation-manifest.json

# Audit artifacts and patch files
.audits/
tmp/
*.patch

# Local agent/tool runtime state (session history, pids, window layout)
.juggler/

# Append-only ingest journal, downloaded from R2 by the scheduled build. The R2 copy is the
# source of truth; committing this one too would recreate exactly the two-authority problem the
# journal removes.
state/


# Python bytecode from running scripts/search_stars_cli.py or py_compile
__pycache__/
*.py[cod]

# Environment-specific secret files
.env.*
!.env.example
.dev.vars.*
!.dev.vars.example

# Private relevance labels for real-corpus retrieval evaluation
data/retrieval-benchmark.private.json
